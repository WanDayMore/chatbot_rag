# ==========================================
# GEMINI API CONFIGURATION
# ==========================================
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001



# ==========================================
# CORS & SECURITY SETTINGS
# ==========================================
# Comma-separated list of origins allowed to call this API
# e.g., http://localhost:3000,https://myportfolio.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourportfolio.com

# ==========================================
# CLOUDFLARE TURNSTILE (Free Bot Protection)
# ==========================================
# Get keys from Cloudflare Dashboard -> Turnstile
# If TURNSTILE_SECRET_KEY is empty or TURNSTILE_ENABLED is false, verification is bypassed (useful for local dev/testing)
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

# ==========================================
# RATE LIMITING & BUDGET GUARDRAILS
# ==========================================
RATE_LIMIT_PER_MINUTE=3
RATE_LIMIT_PER_HOUR=10
RATE_LIMIT_PER_DAY=20
DAILY_GLOBAL_HARD_CAP=500

# ==========================================
# SEMANTIC QUERY CACHING
# ==========================================
# Cosine similarity threshold between 0.0 and 1.0 (recommended: 0.90 to 0.93)
# Higher = stricter match; Lower = more aggressive cache hits
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92
SEMANTIC_CACHE_TTL_DAYS=30

# ==========================================
# STORAGE PATHS
# ==========================================
CHROMA_PERSIST_DIRECTORY=./data/chroma
CACHE_DB_PATH=./data/cache.db
